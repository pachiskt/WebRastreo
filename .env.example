# SierraBim - Configuración de Credenciales
# Reemplaza con tus claves de Google Cloud y Firebase Console

# Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=AIzaSy_TU_GOOGLE_MAPS_API_KEY_AQUI

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=AIzaSy_TU_FIREBASE_API_KEY_AQUI
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-sierrabim.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-sierrabim
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-sierrabim.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789
